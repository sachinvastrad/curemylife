# Copy to .env and fill in real values. Do NOT commit .env.

# Database (MySQL)
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://user:password@localhost:3306/homeopinion"

# JWT
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="30d"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# App
PORT=3001
FRONTEND_URL="http://localhost:3000"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=26214400

# AI Service (OpenAI)
OPENAI_API_KEY=""
AI_MODEL="gpt-4o"

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Notifications
SENDGRID_API_KEY=""
WHATSAPP_API_KEY=""

# Email (SMTP) — leave blank to fall back to console logging in dev
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HomeoOpinion <noreply@homeopinion.in>"
