// HomeoOpinion - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==================== USERS ====================

model Patient {
  id             String    @id @default(uuid())
  email          String?   @unique
  phone          String?
  name           String
  age            Int?
  gender         String?
  city           String?
  preferredLang  String    @default("en")
  googleId       String?   @unique
  abhaId         String?
  avatarUrl      String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // ---- Magic Diet fields ----
  // Anthropometry
  heightCm           Float?
  currentWeightKg    Float?
  targetWeightKg     Float?
  waistCm            Float?
  hipCm              Float?

  // Activity & lifestyle
  activityLevel      String?   // sedentary, light, moderate, heavy, athlete
  exerciseMinsWeek   Int?
  occupation         String?
  avgStepsPerDay     Int?
  sleepHoursAvg      Float?
  stressLevel        String?   // low, moderate, high
  waterIntakeL       Float?
  caffeineCupsDay    Int?
  alcoholFreq        String?   // never, occasional, weekly, daily
  tobaccoUse         Boolean?
  eatOutFreq         String?   // rarely, weekly, daily

  // Diet profile
  dietType           String?   // VEG, NON_VEG, EGGETARIAN, VEGAN, JAIN, SATVIK
  allergens          Json?     // string[] e.g. ["milk","peanut"]
  foodIntolerances   Json?     // string[]
  foodDislikes       Json?     // string[]
  foodLoves          Json?     // string[]
  religiousTags      Json?     // string[]
  fastingWindow      String?   // none, 12:12, 14:10, 16:8, OMAD, 5:2

  // Reproductive
  pregnancyStatus    String?   // none, planning, t1, t2, t3, lactating_0_6, lactating_6_12, postpartum
  menopauseStatus    String?   // pre, peri, post

  // Constitutional
  ayurvedicPrakriti  String?   // vata, pitta, kapha, vata_pitta, pitta_kapha, vata_kapha, tridoshic

  // Regional & cooking
  macroRegion        String?
  state              String?
  cuisineRegion      String?
  budgetTier         String?   // bare_minimum, economy, standard, premium, no_constraint
  cookingTimeTier    String?   // le10, le20, le45, no_limit
  householdSize      Int?

  cases           Case[]
  appointments    Appointment[]
  prescriptions   Prescription[]
  payments        Payment[]
  reviews         DoctorReview[]
  notifications   Notification[]
  biomarkers      PatientBiomarker[]
  dietCharts      PatientDietChart[]
  serviceRequests ServiceRequest[]

  @@map("patients")
}

model Doctor {
  id                  String    @id @default(uuid())
  email               String    @unique
  phone               String?
  name                String
  passwordHash        String?
  googleId            String?   @unique
  qualifications      String?   @db.Text
  cchRegistrationNo   String
  prescribingApproach String?   // classical, pluralist, complex, organ-specific
  experienceYears     Int?
  languages           Json?     // string[] — list of languages
  consultationModes   Json?     // string[] — online, offline
  clinicAddress       String?   @db.Text
  clinicLat           Decimal?  @db.Decimal(10, 8)
  clinicLng           Decimal?  @db.Decimal(11, 8)
  initialFee          Decimal?  @db.Decimal(10, 2)
  followupFee         Decimal?  @db.Decimal(10, 2)
  photoUrl            String?
  avgRating           Decimal   @default(0) @db.Decimal(3, 2)
  totalReviews        Int       @default(0)
  status              String    @default("pending") // pending, approved, suspended, rejected
  rejectionReason     String?   @db.Text
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  specialities     DoctorSpeciality[]
  assignedCases    Case[]            @relation("AssignedDoctor")
  doctorReports    DoctorReport[]
  availability     DoctorAvailability[]
  appointments     Appointment[]
  prescriptions    Prescription[]
  paymentsReceived Payment[]
  payouts          DoctorPayout[]
  reviews          DoctorReview[]
  onboardingDocs   DoctorDocument[]

  @@map("doctors")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  mfaSecret    String?
  mfaEnabled   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("admins")
}

// ==================== SPECIALITIES ====================

model Speciality {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  academicAlign String?
  description   String?  @db.Text
  isActive      Boolean  @default(true)

  doctors       DoctorSpeciality[]
  cases         CaseSpeciality[]
  services      ServiceSpeciality[]

  @@map("specialities")
}

model DoctorSpeciality {
  doctorId     String
  specialityId Int

  doctor       Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  speciality   Speciality @relation(fields: [specialityId], references: [id])

  @@id([doctorId, specialityId])
  @@map("doctor_specialities")
}

// ==================== CASES ====================

model Case {
  id           String   @id @default(uuid())
  patientId    String
  caseNumber   String   @unique
  status       String   @default("draft")
  // statuses: draft, submitted, ai_processing, awaiting_doctor, report_ready,
  //           consultation_booked, consultation_done, closed

  // Chief Complaint
  chiefComplaint     String?  @db.Text
  durationValue      Int?
  durationUnit       String?  // days, weeks, months, years
  previousTreatments String?  @db.Text
  familyHistory      String?  @db.Text
  pastIllnesses      String?  @db.Text

  // Constitutional Profile (Phase 2)
  temperament          Json?     // string[]
  fears                Json?     // string[]
  sleepPosition        String?
  sleepDreams          String?   @db.Text
  sleepQuality         String?
  sleepDisturbances    String?   @db.Text
  emotionalTriggers    String?   @db.Text
  consolationResponse  String?   @db.Text
  foodCravings         Json?     // string[]
  foodAversions        Json?     // string[]
  thermalPreference    String?   // chilly, warm, neither
  thirstQuantity       String?
  thirstFrequency      String?
  thirstTempPref       String?
  perspirationLocation String?
  perspirationTiming   String?
  perspirationOdour    String?

  // Modalities (Phase 2) - stored as JSON
  modalities     Json?

  assignedDoctorId   String?
  submittedAt        DateTime?
  aiCompletedAt      DateTime?
  doctorAcceptedAt   DateTime?
  reportDispatchedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  patient        Patient        @relation(fields: [patientId], references: [id])
  assignedDoctor Doctor?        @relation("AssignedDoctor", fields: [assignedDoctorId], references: [id])
  specialities   CaseSpeciality[]
  documents      CaseDocument[]
  aiReports      AiReport[]
  doctorReports  DoctorReport[]
  appointments   Appointment[]
  prescriptions  Prescription[]

  @@map("cases")
}

model CaseSpeciality {
  caseId       String
  specialityId Int

  case_        Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  speciality   Speciality @relation(fields: [specialityId], references: [id])

  @@id([caseId, specialityId])
  @@map("case_specialities")
}

// ==================== DOCUMENTS ====================

model CaseDocument {
  id            String   @id @default(uuid())
  caseId        String
  fileName      String
  fileType      String   // pdf, jpeg, png, dicom
  fileSizeBytes BigInt
  storageKey    String
  label         String?
  ocrText       String?  @db.Text
  ocrConfidence Decimal? @db.Decimal(5, 2)
  uploadedAt    DateTime @default(now())

  case_         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("case_documents")
}

model DoctorDocument {
  id           String   @id @default(uuid())
  doctorId     String
  docType      String   // bhms_certificate, md_certificate, cch_registration, id_proof, photo
  fileName     String
  storageKey   String
  uploadedAt   DateTime @default(now())

  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_documents")
}

// ==================== AI REPORTS ====================

model AiReport {
  id                  String   @id @default(uuid())
  caseId              String
  version             Int      @default(1)

  // Symptom Extraction
  mentalSymptoms      Json?
  generalSymptoms     Json?
  particularSymptoms  Json?

  // Lab Parsing
  parsedLabValues     Json?    // [{test, value, unit, referenceRange, isAbnormal}]

  // Rubric Suggestions (Phase 2)
  rubricSuggestions   Json?    // [{rubricText, confidence, sourceRepertory}]

  // Constitutional (Phase 2)
  constitutionalTypes Json?    // [{type, rationale, confidence}]

  // Miasmatic (Phase 2)
  predominantMiasm    String?
  miasmRationale      String?  @db.Text
  miasmConfidence     Decimal? @db.Decimal(5, 2)

  // Red Flags (Phase 3)
  redFlags            Json?    // [{symptom, severity, recommendation}]
  hasRedFlags         Boolean  @default(false)

  // Meta
  overallConfidence   Decimal? @db.Decimal(5, 2)
  processingTimeMs    Int?
  modelVersion        String?
  rawResponse         String?  @db.LongText // Full AI response for auditing
  createdAt           DateTime @default(now())

  case_               Case     @relation(fields: [caseId], references: [id])

  @@map("ai_reports")
}

// ==================== DOCTOR REPORTS ====================

model DoctorReport {
  id                      String    @id @default(uuid())
  caseId                  String
  doctorId                String

  aiAgreement             String?   // agree, partially_agree, disagree
  aiAgreementNotes        String?   @db.Text
  additionalObservations  String?   @db.Text
  recommendedRubrics      Json?
  recommendedRemedies     Json?     // [{remedy, potency, rationale}]
  suggestedInvestigations String?   @db.Text
  lifestyleModifications  String?   @db.Text
  redFlagObservations     String?   @db.Text

  dispatchedAt            DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  case_                   Case      @relation(fields: [caseId], references: [id])
  doctor                  Doctor    @relation(fields: [doctorId], references: [id])

  @@map("doctor_reports")
}

// ==================== APPOINTMENTS ====================

model DoctorAvailability {
  id              String  @id @default(uuid())
  doctorId        String
  dayOfWeek       Int     // 0=Sunday, 6=Saturday
  startTime       String  // HH:mm format
  endTime         String  // HH:mm format
  slotDurationMin Int     @default(30)
  bufferMin       Int     @default(10)
  isActive        Boolean @default(true)

  doctor          Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_availability")
}

model Appointment {
  id                 String    @id @default(uuid())
  caseId             String?   // nullable since v1.1 (Service Catalog) — see serviceRequestId
  serviceRequestId   String?   // either caseId or serviceRequestId is set, never both
  patientId          String
  doctorId           String
  appointmentType    String    // video, audio, in_clinic
  isFollowup         Boolean   @default(false)
  scheduledDate      DateTime  @db.Date
  scheduledStart     String    // HH:mm
  scheduledEnd       String    // HH:mm
  status             String    @default("booked") // booked, confirmed, in_progress, completed, cancelled, no_show
  meetingLink        String?
  consultationNotes  String?   @db.Text
  durationMinutes    Int?
  cancelledBy        String?   // patient, doctor, admin
  cancellationReason String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  case_              Case?            @relation(fields: [caseId], references: [id])
  serviceRequest     ServiceRequest?  @relation(fields: [serviceRequestId], references: [id])
  patient            Patient  @relation(fields: [patientId], references: [id])
  doctor             Doctor   @relation(fields: [doctorId], references: [id])
  payment            Payment?
  prescriptions      Prescription[]
  review             DoctorReview?

  @@index([serviceRequestId])
  @@map("appointments")
}

// ==================== PRESCRIPTIONS ====================

model Prescription {
  id                   String   @id @default(uuid())
  caseId               String
  appointmentId        String?
  doctorId             String
  patientId            String
  remedyName           String
  potency              String
  dosage               String
  frequency            String
  duration             String
  dietaryRestrictions  String?  @db.Text
  expectedAggravation  String?  @db.Text
  followupTimeline     String?  @db.Text
  digitalSignature     String?  @db.Text
  pdfStorageKey        String?
  createdAt            DateTime @default(now())

  case_                Case        @relation(fields: [caseId], references: [id])
  appointment          Appointment? @relation(fields: [appointmentId], references: [id])
  doctor               Doctor      @relation(fields: [doctorId], references: [id])
  patient              Patient     @relation(fields: [patientId], references: [id])

  @@map("prescriptions")
}

// ==================== PAYMENTS ====================

model Payment {
  id                  String    @id @default(uuid())
  appointmentId       String    @unique
  patientId           String
  doctorId            String
  amount              Decimal   @db.Decimal(10, 2)
  platformCommission  Decimal?  @db.Decimal(10, 2)
  doctorPayout        Decimal?  @db.Decimal(10, 2)
  currency            String    @default("INR")
  gateway             String    @default("razorpay")
  gatewayPaymentId    String?
  gatewayOrderId      String?
  status              String    @default("pending") // pending, captured, refunded, failed
  refundReason        String?   @db.Text
  paidAt              DateTime?
  refundedAt          DateTime?
  createdAt           DateTime  @default(now())

  appointment         Appointment @relation(fields: [appointmentId], references: [id])
  patient             Patient     @relation(fields: [patientId], references: [id])
  doctor              Doctor      @relation(fields: [doctorId], references: [id])
  payout              DoctorPayout? @relation(fields: [payoutId], references: [id])
  payoutId            String?

  @@map("payments")
}

model DoctorPayout {
  id             String   @id @default(uuid())
  doctorId       String
  amount         Decimal  @db.Decimal(10, 2)
  payoutMethod   String   @default("bank_transfer")
  bankReference  String?
  status         String   @default("pending") // pending, processing, completed, failed
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  doctor         Doctor    @relation(fields: [doctorId], references: [id])
  payments       Payment[]

  @@map("doctor_payouts")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String    @id @default(uuid())
  userId    String
  userRole  String    // patient, doctor, admin
  channel   String    // email, whatsapp, sms, in_app, push
  type      String    // report_ready, appointment_booked, etc.
  title     String
  body      String    @db.Text
  metadata  Json?
  isRead    Boolean   @default(false)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  patient   Patient?  @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ==================== AUDIT ====================

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  userRole     String?
  action       String
  resourceType String
  resourceId   String?
  details      Json?
  ipAddress    String?
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==================== REVIEWS ====================

model DoctorReview {
  id              String    @id @default(uuid())
  doctorId        String
  patientId       String
  appointmentId   String    @unique
  rating          Int       // 1-5
  reviewText      String?   @db.Text
  doctorResponse  String?   @db.Text
  isVisible       Boolean   @default(true)
  moderatedBy     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  doctor          Doctor      @relation(fields: [doctorId], references: [id])
  patient         Patient     @relation(fields: [patientId], references: [id])
  appointment     Appointment @relation(fields: [appointmentId], references: [id])

  @@map("doctor_reviews")
}

// ==================== MAGIC DIET ====================

model Food {
  id                  String   @id @default(uuid())
  name                String
  nameLocal           Json?    // {hi: "...", kn: "...", ta: "..."}
  category            String   // CEREAL_MILLET, PULSE_LEGUME, DAIRY, EGG, FLESH_FOOD, NUT_OILSEED, FAT_OIL, VEGETABLE, GLV, ROOT_TUBER, FRUIT, SPICE, BEVERAGE, PROCESSED, OTHER
  subCategory         String?
  vegType             String   // VEG, EGG, NON_VEG, VEGAN, JAIN
  cuisineRegions      Json?    // string[]
  // Nutrition per 100g raw (IFCT-2017)
  kcalPer100g         Float
  proteinGPer100g     Float    @default(0)
  carbGPer100g        Float    @default(0)
  fatGPer100g         Float    @default(0)
  fiberGPer100g       Float    @default(0)
  sugarGPer100g       Float    @default(0)
  sodiumMgPer100g     Float    @default(0)
  potassiumMgPer100g  Float    @default(0)
  calciumMgPer100g    Float    @default(0)
  ironMgPer100g       Float    @default(0)
  vitaminAUgPer100g   Float    @default(0)
  vitaminCMgPer100g   Float    @default(0)
  vitaminDUgPer100g   Float    @default(0)
  vitaminB12UgPer100g Float    @default(0)
  folateUgPer100g     Float    @default(0)
  omega3GPer100g      Float    @default(0)
  giIndex             Int?     // 0–100 Glycemic Index
  glycemicLoadPer100g Float?
  // Metadata
  allergens           Json?    // string[]
  fodmapLevel         String?  // low, moderate, high
  diseaseAllowed      Json?    // string[] tag whitelist
  diseaseRestricted   Json?    // string[] tag blacklist
  seasonality         Json?    // int[] months 1–12
  costTier            String   @default("standard") // economy, standard, premium
  unitCostInr         Float?
  defaultPortionG     Float    @default(100)
  defaultPortionDesc  String?
  prepTimeMin         Int      @default(0)
  mealSlots           Json?    // string[] e.g. ["breakfast","lunch"]
  // Disease-specific flags (0=none, 1=moderate, 2=high)
  oxalateLevel        Int      @default(0)
  purineLevel         Int      @default(0)
  sodiumLevel         Int      @default(0)
  goitrogenFlag       Boolean  @default(false)
  tyramineFlag        Boolean  @default(false)
  vitaminKHighFlag    Boolean  @default(false)
  source              String   @default("IFCT-2017")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  recipeIngredients   RecipeIngredient[]
  substitutionFrom    FoodSubstitution[] @relation("SubFromFood")
  substitutionTo      FoodSubstitution[] @relation("SubToFood")

  @@index([category])
  @@index([vegType])
  @@map("foods")
}

model Recipe {
  id               String   @id @default(uuid())
  name             String
  cuisine          String?  // karnataka, north_indian, south_indian, etc.
  mealSlots        Json     // string[]
  vegType          String   // VEG, EGG, NON_VEG, VEGAN, JAIN
  prepTimeMin      Int      @default(20)
  difficulty       String   @default("easy") // easy, medium, hard
  servingsBase     Int      @default(1)
  kcalPerServing   Float
  proteinGPerServing Float  @default(0)
  carbGPerServing  Float    @default(0)
  fatGPerServing   Float    @default(0)
  fiberGPerServing Float    @default(0)
  giEstimate       Int?
  instructions     String?  @db.Text
  mustPairWith     Json?    // string[] recipe ids
  tags             Json?    // string[] e.g. ["low-gi","high-protein"]
  conditionTags    Json?    // string[] disease tags this recipe suits
  costTier         String   @default("standard")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  ingredients      RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id        String @id @default(uuid())
  recipeId  String
  foodId    String
  qtyG      Float  // raw grams per servingsBase
  note      String?

  recipe    Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food      Food   @relation(fields: [foodId], references: [id])

  @@map("recipe_ingredients")
}

model FoodSubstitution {
  id              String  @id @default(uuid())
  fromFoodId      String
  toFoodId        String
  contextSlot     String? // breakfast, lunch, dinner, snack — null = any
  reason          String? // lactose, allergy, preference, nutrition_similarity
  similarityScore Float   @default(0.5) // 0–1

  fromFood        Food    @relation("SubFromFood", fields: [fromFoodId], references: [id])
  toFood          Food    @relation("SubToFood", fields: [toFoodId], references: [id])

  @@index([fromFoodId])
  @@map("food_substitutions")
}

model DietTemplate {
  id                    String   @id @default(uuid())
  clinicId              String?  // NULL = global NIN template
  name                  String
  description           String?  @db.Text
  // Classification
  dietType              String   // VEG, NON_VEG, EGGETARIAN, VEGAN, JAIN, SATVIK, ANY
  ageGroup              String   // INFANT,TODDLER,CHILD,TEEN,ADULT,ELDERLY,PREGNANT,LACTATING,ANY
  goal                  String   // weight_loss, weight_gain, diabetes_management, heart_health, pcos, ckd, etc.
  conditionTags         Json?    // string[] disease tags
  cuisineRegions        Json?    // string[]
  // Calorie & macro targets
  targetKcal            Int?
  macroSplit            Json?    // {carbs_pct, protein_pct, fat_pct}
  proteinPerKg          Float?
  giCap                 Int?     // max GI per item
  saltCapG              Float?
  addedSugarCapG        Float?
  oilCapMl              Float?
  potassiumCapMg        Float?
  waterTargetL          Float?
  // Slot distribution
  slotDistribution      Json?    // {early_morning:3, breakfast:22, ...} in %
  // Allowed / avoid foods
  allowedFoods          Json?    // string[] food IDs or names
  avoidFoods            Json?    // string[] food IDs or names
  lifestyleNotes        String?  @db.Text
  supplementHints       String?  @db.Text
  requiresDietitianReview Boolean @default(false)
  source                String   @default("NIN-2024")
  isActive              Boolean  @default(true)
  createdBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  dietCharts            PatientDietChart[]

  @@index([goal])
  @@index([dietType])
  @@map("diet_templates")
}

model PatientBiomarker {
  id          String   @id @default(uuid())
  patientId   String
  visitId     String?  // optional link to appointment
  marker      String   // hba1c, fbs, ldl, hdl, tg, tsh, hb, ferritin, egfr, uric_acid, bp_sys, bp_dia, vit_d, b12
  value       Float
  unit        String   // %, mg/dL, mIU/L, g/dL, etc.
  measuredAt  DateTime
  source      String   @default("manual") // manual, document_parse
  createdAt   DateTime @default(now())

  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, marker])
  @@map("patient_biomarkers")
}

model PatientDietChart {
  id               String    @id @default(uuid())
  patientId        String
  doctorId         String?
  dietTemplateId   String?
  // Generator audit
  inputs           Json?     // full patient profile snapshot used for generation
  snapshot         Json?     // 7-day grid {mon:{early_morning:[...], breakfast:[...], ...}, ...}
  groceryList      Json?     // aisle-grouped grocery list
  patientOverrides Json?     // doctor edits post-generation
  // Denormalised aggregates
  avgDailyKcal     Float?
  avgDailyGi       Float?
  violations       Json?     // [{rule, action, original, replacement}]
  // Delivery
  notes            String?   @db.Text
  pdfUrl           String?
  whatsappSentAt   DateTime?
  version          Int       @default(1)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  patient          Patient      @relation(fields: [patientId], references: [id])
  dietTemplate     DietTemplate? @relation(fields: [dietTemplateId], references: [id])

  @@index([patientId])
  @@map("patient_diet_charts")
}

// ==================== SERVICE CATALOG ====================

model Service {
  id            String    @id @default(uuid())
  slug          String    @unique
  name          String
  tagline       String?   @db.Text
  description   String?   @db.Text       // landing-page body
  howItWorks    Json?                    // [{step, title, body}]
  inclusions    Json?                    // string[]
  iconName      String?                  // lucide-react icon name
  cardImageUrl  String?
  intakeFields  Json                     // FieldDef[] — see PRD-Service-Catalog-IMPLEMENTATION.md §3
  price         Decimal?  @db.Decimal(10, 2)   // reserved for paid services (hidden in v1)
  displayOrder  Int       @default(0)
  isEnabled     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  specialities  ServiceSpeciality[]
  requests      ServiceRequest[]

  @@index([isEnabled, displayOrder])
  @@map("services")
}

model ServiceSpeciality {
  serviceId    String
  specialityId Int

  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  speciality   Speciality @relation(fields: [specialityId], references: [id])

  @@id([serviceId, specialityId])
  @@map("service_specialities")
}

model ServiceRequest {
  id            String    @id @default(uuid())
  serviceId     String
  patientId     String
  status        String    @default("draft") // draft, submitted, booked, completed, cancelled
  intakePayload Json                          // matches Service.intakeFields shape
  notes         String?   @db.Text
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  service       Service       @relation(fields: [serviceId], references: [id])
  patient       Patient       @relation(fields: [patientId], references: [id])
  appointments  Appointment[]

  @@index([patientId])
  @@index([serviceId])
  @@map("service_requests")
}
